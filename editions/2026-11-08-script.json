    {
      "characters": 26,
      "order": 1,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "こんにちは。AIモデル最新情報ラジオ、第22号です。"
    },
    {
      "characters": 29,
      "order": 2,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "2026年11月8日の確認号。基準時は午前8時45分です。"
    },
    {
      "characters": 21,
      "order": 3,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "日付だけの発表は、時刻を補わずに読みます。"
    },
    {
      "characters": 27,
      "order": 4,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "11月7日と8日付の一次記載は、見当たりませんでした。"
    },
    {
      "characters": 28,
      "order": 5,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "そこで11月5日付のGoogleの記載を、初掲載します。"
    },
    {
      "characters": 31,
      "order": 6,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "Gemini APIが、Office文書の入力に対応しました。"
    },
    {
      "characters": 21,
      "order": 7,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "パワーポイントや表計算の文書も、扱えます。"
    },
    {
      "characters": 22,
      "order": 8,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "道具の返答にも、音声や動画や文書が使えます。"
    },
    {
      "characters": 26,
      "order": 9,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "補足は11月2日付、OpenAIの音声の知らせです。"
    },
    {
      "characters": 26,
      "order": 10,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "GPT-Liveの外線発信が、全組織に広がりました。"
    },
    {
      "characters": 23,
      "order": 11,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "電話番号につなぐには、SIP事業者を使います。"
    },
    {
      "characters": 22,
      "order": 12,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "前号の11月6日付の1件は、繰り返しません。"
    },
    {
      "characters": 33,
      "order": 13,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "選定した公式資料の範囲で確認しました。全発表の網羅ではありません。"
    },
    {
      "characters": 28,
      "order": 14,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "日付だけの記載には、時刻やタイムゾーンを補っていません。"
    },
    {
      "characters": 30,
      "order": 15,
      "speaker": "akari",
