    {
      "characters": 26,
      "order": 1,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "こんにちは。AIモデル最新情報ラジオ、第23号です。"
    },
    {
      "characters": 29,
      "order": 2,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "2026年11月9日の確認号。基準時は午前8時45分です。"
    },
    {
      "characters": 22,
      "order": 3,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "今回は新しいモデルの発表が、4件ありました。"
    },
    {
      "characters": 33,
      "order": 4,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "まずAnthropicの、Claude Sonnet 4.6です。"
    },
    {
      "characters": 22,
      "order": 5,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "100万トークンの文脈が、ベータで使えます。"
    },
    {
      "characters": 26,
      "order": 6,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "価格は前のSonnetと同じ、3ドルと15ドルです。"
    },
    {
      "characters": 21,
      "order": 7,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "発表日はページに記載がなく、断定しません。"
    },
    {
      "characters": 18,
      "order": 8,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "次はOpenAI、画像の2.6です。"
    },
    {
      "characters": 25,
      "order": 9,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "SunburstとFlareの、2つのモデルです。"
    },
    {
      "characters": 20,
      "order": 10,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "SVGの出力や、GIFの生成ができます。"
    },
    {
      "characters": 20,
      "order": 11,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "11月4日付の変更履歴で、確認しました。"
    },
    {
      "characters": 39,
      "order": 12,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "次はThinking Machinesの、Inkling 2 Smallです。"
    },
    {
      "characters": 23,
      "order": 13,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "5940億パラメータの、混合専門家モデルです。"
    },
    {
      "characters": 24,
      "order": 14,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "まずはTinkerだけで、重みは来週の予定です。"
    },
    {
      "characters": 23,
      "order": 15,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "最後はGoogle、音声の声を変える機能です。"
    },
    {
      "characters": 24,
      "order": 16,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "11月4日付、Geminiの音声合成の更新です。"
    },
    {
      "characters": 33,
      "order": 17,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "選定した公式資料の範囲で確認しました。全発表の網羅ではありません。"
    },
    {
      "characters": 28,
      "order": 18,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "日付だけの記載には、時刻やタイムゾーンを補っていません。"
    },
    {
      "characters": 27,
      "order": 19,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "以上、第23号でした。発表元のページをご確認ください。"
    }
  ]
