    {
      "characters": 26,
      "order": 1,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "こんにちは。AIモデル最新情報ラジオ、第35号です。"
    },
    {
      "characters": 30,
      "order": 2,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "2026年11月21日の確認号。基準時は午前8時45分です。"
    },
    {
      "characters": 18,
      "order": 3,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "今回は新しい発表が、2件ありました。"
    },
    {
      "characters": 36,
      "order": 4,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "MicrosoftのAion Instructです。11月19日付です。"
    },
    {
      "characters": 18,
      "order": 5,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "ブラウザーで動く、小さなモデルです。"
    },
    {
      "characters": 28,
      "order": 6,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "23億パラメーターで、Phi-4-miniと代わります。"
    },
    {
      "characters": 15,
      "order": 7,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "文章や要約、翻訳にも使えます。"
    },
    {
      "characters": 19,
      "order": 8,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "サイトから呼べる、試験も始まりました。"
    },
    {
      "characters": 20,
      "order": 9,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "Googleの文字起こしも、紹介します。"
    },
    {
      "characters": 16,
      "order": 10,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "11月17日付で、声で直せます。"
    },
    {
      "characters": 17,
      "order": 11,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "話した言葉や、元の文章を整えます。"
    },
    {
      "characters": 15,
      "order": 12,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "録音用と生の会話用、両方です。"
    },
    {
      "characters": 15,
      "order": 13,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "前号の3件は、繰り返しません。"
    },
    {
      "characters": 34,
      "order": 14,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "OpenAIやAnthropic、xAIの最新は、変わっていません。"
    },
    {
      "characters": 22,
      "order": 15,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "Metaの新しいモデルも、ありませんでした。"
    },
    {
      "characters": 33,
      "order": 16,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "選定した公式資料の範囲で確認しました。全発表の網羅ではありません。"
    },
    {
      "characters": 28,
      "order": 17,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "日付だけの記載には、時刻やタイムゾーンを補っていません。"
    },
    {
      "characters": 27,
      "order": 18,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "以上、第35号でした。発表元のページをご確認ください。"
