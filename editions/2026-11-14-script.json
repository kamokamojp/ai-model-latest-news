  "utterances": [
    {
      "characters": 26,
      "order": 1,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "こんにちは。AIモデル最新情報ラジオ、第28号です。"
    },
    {
      "characters": 30,
      "order": 2,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "2026年11月14日の確認号。基準時は午前8時45分です。"
    },
    {
      "characters": 18,
      "order": 3,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "今回は新しい発表が、1件ありました。"
    },
    {
      "characters": 32,
      "order": 4,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "ByteDanceの、Seedance 2.5 Flashです。"
    },
    {
      "characters": 21,
      "order": 5,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "11月12日付、動画生成モデルの新版です。"
    },
    {
      "characters": 23,
      "order": 6,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "2倍の速さで、価格は約3割安いとされています。"
    },
    {
      "characters": 21,
      "order": 7,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "720pでは、1秒あたり約0.99元です。"
    },
    {
      "characters": 25,
      "order": 8,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "1本は最長30秒、480pと720pに対応します。"
    },
    {
      "characters": 18,
      "order": 9,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "画像や動画、音声を参照して作れます。"
    },
    {
      "characters": 14,
      "order": 10,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "動画編集にも対応しています。"
    },
    {
      "characters": 25,
      "order": 11,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "量産向けで、仕上げはSeedance 2.5です。"
    },
    {
      "characters": 29,
      "order": 12,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "APIは11月15日に、Volcano Arkで開きます。"
    },
    {
      "characters": 31,
      "order": 13,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "今回の確認では、11月13日付の新発表は見つかりませんでした。"
    },
    {
      "characters": 40,
      "order": 14,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "GoogleやOpenAI、Anthropicの変更履歴に、新項目はありません。"
    },
    {
      "characters": 33,
      "order": 15,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "選定した公式資料の範囲で確認しました。全発表の網羅ではありません。"
    },
    {
      "characters": 28,
      "order": 16,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "日付だけの記載には、時刻やタイムゾーンを補っていません。"
    },
    {
      "characters": 27,
      "order": 17,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "以上、第28号でした。発表元のページをご確認ください。"
    }
