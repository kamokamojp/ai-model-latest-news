  "utterances": [
    {
      "characters": 26,
      "order": 1,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "こんにちは。AIモデル最新情報ラジオ、第19号です。"
    },
    {
      "characters": 29,
      "order": 2,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "2026年11月5日の確認号。基準時は午前8時40分です。"
    },
    {
      "characters": 21,
      "order": 3,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "日付だけの発表は、時刻を補わずに読みます。"
    },
    {
      "characters": 23,
      "order": 4,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "今回は11月4日付の記載、2件を初掲載します。"
    },
    {
      "characters": 26,
      "order": 5,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "まずOpenAI。画像生成の2モデルが登場しました。"
    },
    {
      "characters": 31,
      "order": 6,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "GPT-Image-2.6のSunburstとFlareです。"
    },
    {
      "characters": 19,
      "order": 7,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "複雑さの調整や、SVG生成ができます。"
    },
    {
      "characters": 22,
      "order": 8,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "動くGIFの生成にも対応すると載っています。"
    },
    {
      "characters": 25,
      "order": 9,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "指示で部分を直す編集も、対応モデルで加わりました。"
    },
    {
      "characters": 29,
      "order": 10,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "次はGoogle。Gemini 3.8の音声の新機能です。"
    },
    {
      "characters": 23,
      "order": 11,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "声のリミックス。既存の声を言葉で変えられます。"
    },
    {
      "characters": 21,
      "order": 12,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "新しい声として保存し、音声合成に使えます。"
    },
    {
      "characters": 38,
      "order": 13,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "合成には、Flash TTSとFlash-Lite TTSが挙がっています。"
    },
    {
      "characters": 29,
      "order": 14,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "前号の11月3日付の透かしは、新発表として繰り返しません。"
    },
    {
      "characters": 30,
      "order": 15,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "11月5日付の一次記載は、選定ページに見当たりませんでした。"
    },
    {
      "characters": 33,
      "order": 16,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "選定した公式資料の範囲で確認しました。全発表の網羅ではありません。"
    },
    {
      "characters": 28,
      "order": 17,
      "speaker": "akari",
      "speaker_id": 10005,
      "text": "日付だけの記載には、時刻やタイムゾーンを補っていません。"
    },
    {
      "characters": 31,
      "order": 18,
      "speaker": "naoto",
      "speaker_id": 10001,
      "text": "以上、第19号でした。モデルと日付、利用条件をご確認ください。"
    }
  ],
